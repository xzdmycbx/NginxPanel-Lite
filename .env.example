# 面板管理界面 + API 的对外端口（SPA 同源提供）
PANEL_HTTP_PORT=8080

# JWT 签名密钥。留空则首次启动自动生成并持久化到 /data；
# 或设置一个 32 字节以上的随机值（openssl rand -hex 32）以便固定/轮换。
PANEL_JWT_SECRET=

# TOTP 密钥静态加密密钥（AES-GCM）。留空则从 JWT 密钥派生。
PANEL_SECRET_KEY=

# 面板控制的 nginx 容器名，必须与 docker-compose.yml 中 nginx 服务的 container_name 一致。
NGINX_CONTAINER_NAME=nginx-panel-nginx

# Cookie Secure 标志。生产建议在面板自身的 HTTPS 后面运行并设为 true；
# 纯 HTTP 访问（如内网/本地）需设为 false 否则 Cookie 不会下发。
PANEL_COOKIE_SECURE=false

# Let's Encrypt 默认联系邮箱 + 是否使用测试环境（强烈建议先用 staging 验证）。
ACME_EMAIL=admin@example.com
ACME_STAGING=true
