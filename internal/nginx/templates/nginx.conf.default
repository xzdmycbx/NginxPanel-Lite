user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout  65;
    server_tokens   off;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';
    access_log  /var/log/nginx/access.log  main;

    # Required for WebSocket proxying in generated site configs.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Shared proxy cache zone used by per-location "缓存" toggles.
    proxy_cache_path /var/cache/nginx/npl levels=1:2 keys_zone=npl_cache:10m
                     max_size=1g inactive=60m use_temp_path=off;

    # Default server: serves the ACME challenge before any site exists and
    # returns 404 for unmatched hosts.
    server {
        listen 80 default_server;
        server_name _;

        location /.well-known/acme-challenge/ {
            root /var/www/acme-webroot;
            default_type "text/plain";
            try_files $uri =404;
        }

        location = /healthz {
            access_log off;
            return 200 "ok\n";
        }

        location / {
            return 404;
        }
    }

    # Per-domain main files generated by the panel (1Panel-style nested includes).
    include /etc/nginx-panel/sites/site-*/site.conf;
}
